# Anthropic API key (https://console.anthropic.com) - powers receipt reading.
# Leave empty to run in demo mode with a sample receipt.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# PayPal sandbox REST app credentials (https://developer.paypal.com/dashboard/applications/sandbox)
# Leave empty to run in demo mode with simulated payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

PORT=3000
